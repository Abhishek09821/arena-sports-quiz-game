# ═══════════════════════════════════════════════════════════════
# ARENA SPORTS QUIZ — Environment Variables Configuration
# ═══════════════════════════════════════════════════════════════

# ── SUPABASE (Database, Auth, Realtime) ────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ═══════════════════════════════════════════════════════════════
# ── 3 DISTINCT AI API KEYS FOR 3 DISTINCT GAME MODES ──────────
# ═══════════════════════════════════════════════════════════════

# ── MODE 1: 1v1 MULTIPLAYER (Low latency, speed-optimized) ─────
# Primary: Groq API Key (https://console.groq.com/keys) or xAI Grok (https://console.x.ai/)
MULTIPLAYER_AI_API_KEY=your-multiplayer-groq-key
GROQ_API_KEY=your-multiplayer-groq-key
GROQ_MODEL=llama-3.3-70b-versatile

# ── MODE 2: CHALLENGE MODE (High accuracy, curriculum) ─────────
# Primary: Google Gemini API Key (https://aistudio.google.com/)
CHALLENGE_AI_API_KEY=your-challenge-gemini-key
GEMINI_API_KEY=your-challenge-gemini-key
AI_MODEL=gemini-2.5-flash

# ── MODE 3: KNOW YOUR IDOL MODE (Deep sports history) ──────────
# Primary: Dedicated Gemini API Key (https://aistudio.google.com/)
IDOL_AI_API_KEY=your-idol-gemini-key
GEMINI_IDOL_API_KEY=your-idol-gemini-key
IDOL_AI_MODEL=gemini-2.5-flash

# ═══════════════════════════════════════════════════════════════
# ── ARTIFICIAL ADMIN PORTAL CREDENTIALS (NO EMAIL / NO GOOGLE) 
# ═══════════════════════════════════════════════════════════════
ADMIN_PORTAL_ID=admin18
ADMIN_SECRET_KEY=viratkohli18
