# ═══════════════════════════════════════════════════════════════
# ARENA SPORTS QUIZ — Environment Variables Configuration
# ═══════════════════════════════════════════════════════════════

# ── SUPABASE (Database, Auth, Realtime) ────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ═══════════════════════════════════════════════════════════════
# ── DUAL AI PROVIDER ARCHITECTURE ─────────────────────────────
# ═══════════════════════════════════════════════════════════════

# ── AI PROVIDER 1: Google Gemini ──────────────────────────────
# Exclusively powers: CLASSIC MODE & CHALLENGE MODE
# Obtain free key at: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key
AI_MODEL=gemini-2.5-flash

# ── AI PROVIDER 2: Grok / Groq API ────────────────────────────
# Exclusively powers: 1v1 MULTIPLAYER & 60s BLITZ SPRINT
# Option A (Recommended Free Tier - Groq Llama/Grok engine):
# Obtain free instant API key at: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Option B (Official xAI Grok):
# Obtain at: https://console.x.ai/
# XAI_API_KEY=your-xai-api-key
# XAI_MODEL=grok-beta
