# ═══════════════════════════════════════════════════════════════
# ARENA SPORTS QUIZ — Environment Variables Configuration
# ═══════════════════════════════════════════════════════════════

# ── SUPABASE (Frontend & Client) ──────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# ── SUPABASE (Backend Server-Side Privileged Key) ─────────────
# Required for server-side question persistence, bypassing RLS safely on server,
# and executing administrative actions. NEVER expose to frontend.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── AI QUESTION GENERATOR CONFIGURATION ───────────────────────
# Choose your active provider: gemini | groq | openrouter | openai
# Default is 'gemini' using Google AI Studio free tier.
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash

# Google Gemini API Key (Recommended Free Tier: 15 RPM, 1,500 RPD free)
# Obtain at: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key

# Optional Alternative Free-Tier Providers:
# Groq (Fast, generous free tier: https://console.groq.com)
GROQ_API_KEY=
# OpenRouter (Free models available: https://openrouter.ai)
OPENROUTER_API_KEY=
# OpenAI
OPENAI_API_KEY=
